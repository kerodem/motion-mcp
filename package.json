{
  "name": "motion-mcp",
  "version": "0.1.0",
  "description": "An MCP server for Apple Motion — inspect and edit .motn/.moti project XML and drive the Motion app.",
  "type": "module",
  "license": "MIT",
  "author": "kerodem",
  "repository": {
    "type": "git",
    "url": "https://github.com/kerodem/motion-mcp.git"
  },
  "bin": {
    "motion-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "start": "node dist/index.js",
    "prepare": "npm run build",
    "test": "npm run build && node --test",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "apple-motion",
    "motion",
    "final-cut-pro",
    "motn",
    "motion-graphics"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@xmldom/xmldom": "^0.9.10",
    "xpath": "^0.0.34",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "typescript": "^5.9.3"
  }
}
